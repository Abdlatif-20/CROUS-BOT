CROUS_SEARCH_URL=https://trouverunlogement.lescrous.fr/tools/48/search?bounds=7.6881371_48.6461896_7.8360646_48.491861
# Optional: monitor multiple locations at once (comma-separated). If set, this overrides CROUS_SEARCH_URL.
# CROUS_SEARCH_URLS=https://trouverunlogement.lescrous.fr/tools/48/search?...,...
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token
TELEGRAM_CHAT_ID=replace_with_your_chat_id
# Optional: comma-separated recipient/control chats. If set, this overrides TELEGRAM_CHAT_ID.
# TELEGRAM_CHAT_IDS=6419615924,8305376405

# Polling and safety controls
POLL_INTERVAL_SECONDS=180
POLL_JITTER_SECONDS=20
# Pause between listing alerts in one cycle (spreads bursts, avoids Discord/Telegram rate limits)
ALERT_DELAY_SECONDS=3
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=2

# Runtime
STATE_DB_PATH=data/state.db
LOG_LEVEL=INFO
USER_AGENT=CROUS-BOT/1.0 (+personal-use; respectful polling)

# Smart filters (optional)
# Example: 350
FILTER_MAX_PRICE_EUR=
# Comma-separated keywords, case-insensitive. Example: strasbourg,illkirch,igbmc
FILTER_INCLUDE_KEYWORDS=
# Only alert for listings in Île-de-France or within this many km of its border. Example: 10
# Pair it with a search URL covering IDF + margin, e.g. bounds=1.30_49.34_3.70_48.02
FILTER_IDF_MAX_DISTANCE_KM=

# Health and reliability alerts
HEARTBEAT_ENABLED=false
HEARTBEAT_INTERVAL_HOURS=168
ERROR_ALERT_THRESHOLD=3
ERROR_ALERT_COOLDOWN_MINUTES=180

# Discord alerts (optional): channel settings → Integrations → Webhooks → New Webhook → Copy Webhook URL.
# Treat it like a password: anyone with the URL can post to the channel.
DISCORD_WEBHOOK_URL=
